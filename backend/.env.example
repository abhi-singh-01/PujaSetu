NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/pujasetu
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
OTP_EXPIRY_MINUTES=10
# Advance booking deposit (% of total) — default 15
ADVANCE_PAYMENT_PERCENT=15
# OTP for mutual customer+provider verification before remaining payment
COMPLETION_OTP_EXPIRY_MINUTES=30
# Dev: any OTP works when DEV_OTP_BYPASS=true
DEV_OTP_BYPASS=true
DEV_OTP_CODE=123456

# Twilio (SMS OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# DigiLocker OAuth
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=http://localhost:5000/api/auth/digilocker/callback

# Google Maps
GOOGLE_MAPS_API_KEY=

# Firebase (push via FCM server key for legacy or use Firebase Admin)
FIREBASE_SERVER_KEY=

# Frontend URL (CORS)
CLIENT_URL=http://localhost:8081
