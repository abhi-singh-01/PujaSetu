# Copy to .env before production deploy:
#   cp .env.docker.example .env
#
# Used by docker-compose.prod.yml (repo root) or backend/docker-compose.prod.yml

API_PORT=5000

# Required in production
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-characters
CLIENT_URL=https://your-app.com,exp://your-expo-app

# MongoDB — use Atlas URI in production, or omit for bundled Mongo (--profile with-db)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/pujasetu?retryWrites=true&w=majority

# Optional
JWT_ACCESS_EXPIRATION_MS=604800000
JWT_REFRESH_EXPIRATION_MS=2592000000
ADVANCE_PAYMENT_PERCENT=15
COMPLETION_OTP_EXPIRY_MINUTES=30

# Payments & integrations (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
